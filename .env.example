# Copy to .env / .env.local per app and fill in real values.
# Never commit filled-in .env files.

# ---- shared ----
NODE_ENV=development
TZ=UTC

# ---- API (apps/api/.env) ----
# Database (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://hrms:hrms_dev_password@127.0.0.1:5432/hrms?schema=public

# Redis (for refresh-token revocation list + BullMQ queues)
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-at-least-64-chars-long-aaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-64-chars-long-aaaaaaaaaaaaa
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=hrms

# Short-lived (2 min) token used between password check and MFA verification.
JWT_CHALLENGE_TTL=2m
JWT_CHALLENGE_SECRET=change-me-challenge-secret-64-chars-aaaaaaaaaaaaaaaaaaaaa

# App URLs
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
API_PREFIX=/api
PORT=3000

# SMTP (Mailhog in dev; external provider in prod)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hrms.local

# Object storage (MinIO in dev / S3-compatible in prod)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=hrms_minio
S3_SECRET_ACCESS_KEY=hrms_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000

# Misc
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
COOKIE_DOMAIN=localhost

# ---- Web (apps/web/.env) ----
VITE_API_BASE_URL=http://localhost:3000/api

# Production environment template.
# Copy to /opt/hrms/.env.prod on the server and fill in real values.
# Generate JWT secrets with:  openssl rand -base64 64
# Lock down with:  chmod 600 .env.prod

NODE_ENV=production
TZ=UTC

# ---- Postgres (used by compose to create the DB + by the API to connect) ----
POSTGRES_USER=hrms
POSTGRES_PASSWORD=__CHANGE_ME_STRONG__
POSTGRES_DB=hrms
DATABASE_URL=postgresql://hrms:__CHANGE_ME_STRONG__@127.0.0.1:5432/hrms?schema=public

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- JWT (each ≥ 64 chars) ----
JWT_ACCESS_SECRET=__GENERATE_WITH_openssl_rand_base64_64__
JWT_REFRESH_SECRET=__GENERATE_WITH_openssl_rand_base64_64__
JWT_CHALLENGE_SECRET=__GENERATE_WITH_openssl_rand_base64_64__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=hrms

# ---- App URLs (your real domain) ----
APP_BASE_URL=https://hrms.example.com
API_BASE_URL=https://hrms.example.com/api
API_PREFIX=/api
PORT=3000

# ---- Cookies ----
CORS_ORIGINS=https://hrms.example.com
COOKIE_DOMAIN=hrms.example.com
COOKIE_SECURE=true

# ---- Security ----
BCRYPT_ROUNDS=12
LOG_LEVEL=info

# ---- SMTP (transactional provider recommended) ----
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=__SMTP_USER__
SMTP_PASS=__SMTP_PASS__
SMTP_FROM=no-reply@hrms.example.com

# ---- Object storage (MinIO container) ----
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=__MINIO_ROOT_USER__
S3_SECRET_ACCESS_KEY=__MINIO_ROOT_PASSWORD__
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://files.example.com

# ---- GHCR image refs (used by compose) ----
GHCR_OWNER=__YOUR_GITHUB_OWNER_OR_ORG__
IMAGE_TAG=latest

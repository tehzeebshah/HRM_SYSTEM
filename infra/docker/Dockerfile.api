# Multi-stage build for the HRMS API.
# Base: Node 20 LTS (Alpine). Runs as non-root `node` user.
# Build context = repo root. See infra/docker/docker-compose.*.yml.

# ---------- 1. base ----------
FROM node:20-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

# ---------- 2. deps (prod + dev, cached) ----------
FROM base AS deps
COPY pnpm-workspace.yaml package.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------- 3. build ----------
FROM deps AS build
COPY tsconfig.json ./
COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
# Generate Prisma client, then compile
RUN pnpm --filter @hrms/api exec prisma generate
RUN pnpm --filter @hrms/api run build

# ---------- 4. prod-deps ----------
FROM base AS prod-deps
COPY pnpm-workspace.yaml package.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ---------- 5. runtime ----------
FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Install dumb-init for clean signal handling, openssl needed by Prisma.
RUN apk add --no-cache dumb-init openssl tini

# Bring compiled output + prod deps + prisma schema/migrations.
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/packages ./packages
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY apps/api/prisma ./apps/api/prisma
COPY package.json pnpm-workspace.yaml ./

WORKDIR /app/apps/api
EXPOSE 3000

# Healthcheck hits the public /api/health endpoint inside the container.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

USER node
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]

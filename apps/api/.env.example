# Database (local dev — matches infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://hrms:hrms_dev_password@127.0.0.1:5432/hrms?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT secrets — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-at-least-64-chars-long-aaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-64-chars-long-aaaaaaaaaaaaa
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=hrms
JWT_CHALLENGE_TTL=2m
JWT_CHALLENGE_SECRET=change-me-challenge-secret-64-chars-aaaaaaaaaaaaaaaaaaaaa

# URLs / ports
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
API_PREFIX=/api
PORT=3000

# SMTP (Mailhog)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hrms.local

# S3 / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=hrms_minio
S3_SECRET_ACCESS_KEY=hrms_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000

BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
COOKIE_DOMAIN=localhost
